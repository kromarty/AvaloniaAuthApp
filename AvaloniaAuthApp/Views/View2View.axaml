<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaAuthApp.ViewModels"
             x:Class="AvaloniaAuthApp.Views.View2View"
             x:DataType="vm:View2ViewModel">

    <StackPanel Spacing="10">
        <TextBlock Text="О разработчике" FontWeight="Bold" FontSize="18"/>
        <TextBlock Text="{Binding DeveloperName, StringFormat='Имя: {0}'}"/>
        <TextBlock Text="{Binding DeveloperDescription, StringFormat='Описание: {0}'}"/>
        <TextBlock Text="{Binding ContactInfo, StringFormat='Контакты: {0}'}"/>
    </StackPanel>
</UserControl>